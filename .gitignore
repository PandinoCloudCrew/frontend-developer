# =============================================
# .gitignore para Guía de Desarrollo Frontend
# Cubre los artefactos que el estudiante generará
# al seguir las actividades de cada etapa
# =============================================

# === Sistema operativo ===
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# === Editores e IDEs ===
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# === Herramientas de IA ===
.claude/

# === Dependencias ===
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# === Lock files ===
# Descomentar si prefieres versionarlos (recomendado en proyectos reales)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lockb

# === Build y output ===
dist/
build/
out/
*.tsbuildinfo

# === Framework-specific build outputs ===
# Next.js
.next/
# Nuxt
.nuxt/
.output/
# SvelteKit
.svelte-kit/
# Analog (Angular)
.analog/
# Astro
.astro/
# Vite
*.timestamp-*

# === Cache ===
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.biome/

# === Testing ===
# Etapa 7: cobertura y reportes de tests
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Variables de entorno ===
# Etapa 6: nunca versionar secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# === Mockups exportados ===
# Los mockups se versionan como referencia visual para los estudiantes
# Se regeneran desde archivos .pen si es necesario

# === Archivos temporales ===
*.tmp
*.bak
*.orig
